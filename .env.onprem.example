# Copy to .env.onprem. This profile is safe only for local development.
INFRASTRUCTURE_MODE=on_premise
DEPLOYMENT_ENVIRONMENT=development

POSTGRES_USER=onyx_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=onyx_db
PG_CONNECTION_ONPREM=postgresql+psycopg://onyx_user:change_me@localhost:5433/onyx_db
RAG_TABLE_NAME=onyx_rag_onprem

REDIS_URI=redis://localhost:6380
RAG_CONTEXT_REDIS_URI_ONPREM=redis://localhost:6380
RAG_CONTEXT_CACHE=redis
RAG_CONTEXT_TTL_SECONDS=300
RAG_CACHE_ALLOWED_CLASSIFICATIONS=public,internal

# Workstation profile: state is lost when the UI process exits.
LANGGRAPH_CHECKPOINTER=memory
LONG_TERM_MEMORY_BACKEND=memory
RAG_SECURITY_PROFILE=development
AUDIT_BACKEND=jsonl

# Start the LM Studio local server before launching Onyx.
ONPREM_CHAT_BASE_URL=http://127.0.0.1:1234/v1
ONPREM_CHAT_MODEL=ministral-3-3b-instruct-2512
ONPREM_CHAT_API_KEY=not-needed
ONPREM_EMBEDDING_DEVICE=cpu

# Disable the larger cross-encoder for the first smoke test.
RERANKER_ENABLED=false
RAG_DOCLING=0
FTS_LANGUAGE=pg_catalog.spanish
LANGSMITH_TRACING=false
