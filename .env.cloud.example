# Copy to .env.cloud and replace every change_me value.
INFRASTRUCTURE_MODE=cloud
DEPLOYMENT_ENVIRONMENT=development

PG_CONNECTION_CLOUD=postgresql+psycopg://user:change_me@server.postgres.database.azure.com:5432/onyx_db?sslmode=require
RAG_TABLE_NAME=onyx_rag_cloud

AZURE_FOUNDRY_ENDPOINT=https://change_me.services.ai.azure.com/openai/v1
AZURE_FOUNDRY_API_KEY=change_me
AZURE_OPENAI_DEPLOYMENT_NAME=text-embedding-3-large
AZURE_CHAT_DEPLOYMENT=change_me

# Use development for the first local smoke test. Set managed after configuring
# Content Safety and an Azure AI Language endpoint that supports PII.
RAG_SECURITY_PROFILE=development
AZURE_CONTENT_SAFETY_ENDPOINT=https://change_me.cognitiveservices.azure.com
AZURE_CONTENT_SAFETY_KEY=change_me
AZURE_CONTENT_SAFETY_BLOCK_SEVERITY=4
# Set these when the Foundry resource region does not expose Azure Language PII.
AZURE_LANGUAGE_ENDPOINT=https://change_me.cognitiveservices.azure.com
AZURE_LANGUAGE_KEY=change_me

# Cheap workstation cloud test: Azure models/database, local process state.
RAG_CONTEXT_CACHE=memory
LANGGRAPH_CHECKPOINTER=memory
LONG_TERM_MEMORY_BACKEND=memory
AUDIT_BACKEND=jsonl

RERANKER_ENABLED=false
RAG_DOCLING=0
FTS_LANGUAGE=pg_catalog.spanish
LANGSMITH_TRACING=false
