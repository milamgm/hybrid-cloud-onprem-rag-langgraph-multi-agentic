# Do not commit the copied .env file.
# Use a long, random value from your approved secret manager.
LITELLM_MASTER_KEY=replace-with-a-long-random-secret

# Development: LM Studio runs on the Docker host. From inside the LiteLLM
# container use host.docker.internal, not localhost. For vLLM/NIM replace this
# with its private service URL; both must include /v1.
ONPREM_UPSTREAM_BASE_URL=http://host.docker.internal:1234/v1
ONPREM_UPSTREAM_API_KEY=not-needed

# LiteLLM expects the provider prefix for an OpenAI-compatible upstream. Match
# the model identifier displayed by LM Studio; use the deployed vLLM/NIM model
# identifier when promoting to a larger environment.
ONPREM_LITELLM_MODEL=openai/ministral-3-3b-instruct-2512
