# Copy to .env and fill in. Never commit .env — it holds live credentials.

# ── Deployment target ─────────────────────────────────────────
# cloud      -> Azure AI Foundry embeddings + Azure PostgreSQL
# on_premise -> BAAI/bge-m3 on local hardware + Docker PostgreSQL
INFRASTRUCTURE_MODE=on_premise

REDIS_URI=redis://localhost:6379
RAG_TABLE_NAME=onyx_corporate_knowledge

# ── Postgres ──────────────────────────────────────────────────
POSTGRES_USER=onyx_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=onyx_db

PG_CONNECTION_ONPREM=postgresql+psycopg://onyx_user:change_me@localhost:5432/onyx_db
PG_CONNECTION_CLOUD=postgresql+psycopg://user:password@your-server.postgres.database.azure.com:5432/onyx_db

# ── Azure AI Foundry (cloud mode only) ────────────────────────
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1
# Azure routes on the deployment name, which need not match the base model name.
AZURE_OPENAI_DEPLOYMENT_NAME=text-embedding-3-large

# â”€â”€ AI/API gateways â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Cloud: APIM exposes the OpenAI-compatible route /ai/v1/chat/completions and
# authenticates application callers with the subscription key. Leave both blank
# only when developing directly against Foundry.
AZURE_APIM_GATEWAY_URL=
AZURE_APIM_SUBSCRIPTION_KEY=

# On-premise: LiteLLM exposes /v1/chat/completions. The API key is a LiteLLM
# virtual key in production (the master key is only suitable for bootstrap).
ONPREM_LITELLM_BASE_URL=
ONPREM_LITELLM_API_KEY=
ONPREM_LITELLM_MODEL=onprem-primary

# ── Privacy / DLP ─────────────────────────────────────────────
# Cloud PII: Azure Language Text PII through the Microsoft Foundry resource
# above. The middleware derives the Language runtime URL from the Foundry
# endpoint, so a separate AZURE_LANGUAGE_* pair is not required.
# Legacy AZURE_LANGUAGE_ENDPOINT/AZURE_LANGUAGE_KEY are still accepted.
# Azure AI Content Safety resource (moderation and harmful-content filtering).
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=
AZURE_CONTENT_SAFETY_BLOCK_SEVERITY=4

# Output validation. JSON/Pydantic/JSON Schema and citation-marker checks run
# in-process. PII is redacted by the Privacy middleware above; Content Safety
# blocks harmful generated output in cloud mode.
# On-premise NeMo uses a separate Content Safety NIM from JailbreakDetect.
NEMO_CONTENT_SAFETY_NIM_BASE_URL=http://localhost:8124/v1
NEMO_CONTENT_SAFETY_NIM_MODEL=nvidia/llama-3.1-nemotron-safety-guard-8b-v3

# ── Workload identity and secrets ─────────────────────────────
# Cloud: Key Vault is accessed with DefaultAzureCredential. In Azure this is a
# managed/federated workload identity, not an application API key.
AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net/
# Set only for a user-assigned managed identity; omit for system-assigned.
AZURE_CLIENT_ID=

# On-premise: Vault validates a short-lived JWT from Keycloak or Entra ID.
# Prefer VAULT_JWT_FILE from a projected workload token; never commit VAULT_JWT.
VAULT_ADDR=https://vault.example.internal:8200
VAULT_CACERT=/var/run/secrets/onyx/ca.crt
VAULT_JWT_ROLE=onyx-workload
VAULT_JWT_FILE=/var/run/secrets/onyx/workload.jwt
VAULT_KV_MOUNT=secret

# ── Governance, evidence and observability ───────────────────
# Hash-chained local evidence: versions, decisions, metrics, incidents and
# risk reviews. Use immutable/WORM storage or a SIEM in production.
GOVERNANCE_EVIDENCE_PATH=var/evidence/governance.jsonl
# Cloud: Azure Monitor receives OpenTelemetry through this connection string.
APPLICATIONINSIGHTS_CONNECTION_STRING=
# On-premise: the OpenTelemetry Collector forwards all three signals to SIEM.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SIEM_OTLP_ENDPOINT=https://siem.example.internal/v1/otlp
SIEM_OTLP_AUTHORIZATION=Bearer replace_me

# Prompt injection / jailbreak protection.
# Cloud uses the Azure Content Safety resource above (Prompt Shields).
# On-premise uses the dedicated NemoGuard JailbreakDetect NIM, not the
# application LLM. It is started from infrastructure/security/nemo-guardrails.
NEMO_JAILBREAK_NIM_BASE_URL=http://localhost:8123/v1/
NVIDIA_API_KEY=

# Agent tool authorization. OPA is the on-premise policy decision point.
OPA_URL=http://localhost:8181
# On-premise PII: Presidio containers, bound to localhost by default.
PRESIDIO_ANALYZER_URL=http://localhost:5002
PRESIDIO_ANONYMIZER_URL=http://localhost:5001

# ── Web search (cloud only) ───────────────────────────────────
# internal_only disables external web access. approved_web requires a domain allowlist.
WEB_SEARCH_POLICY=internal_only
WEB_SEARCH_ALLOWED_DOMAINS=
TAVILY_API_KEY=

# ── Embedding quota tuning (cloud mode only) ──────────────────
# These exist because managed embedding endpoints enforce both a requests- and a
# tokens-per-minute quota. Exceeding either returns HTTP 429.
#
# Read your deployment's real limits in Azure AI Foundry
# (Deployments -> your deployment -> Quota), then set:
#
#   EMBEDDINGS_REQUESTS_PER_SECOND = (deployment RPM / 60) * 0.8
#
# The 0.8 leaves headroom for retrieval traffic running alongside an ingest.
# If the binding limit is tokens rather than requests, the ceiling is
# TPM / (EMBEDDINGS_BATCH_SIZE * average tokens per chunk) requests per minute.
# Lowering the batch size does not raise total throughput in that case -- it
# only smooths consumption. Raise the quota instead:
# https://aka.ms/oai/quotaincrease
EMBEDDINGS_REQUESTS_PER_SECOND=1.0

# Inputs per request. This is a FEASIBILITY setting, not just a throughput one:
# a single request whose token count exceeds the per-minute quota can never
# succeed, no matter how long the client waits. Measured on this project: 71
# chunks (~23k tokens) in one request failed indefinitely on a small deployment,
# while the same work in batches of 16 (~5k tokens) completed in 2.5 minutes.
# Estimate your ceiling as: batch_size * average tokens per chunk < your TPM.
EMBEDDINGS_BATCH_SIZE=16

# Retries before a rate-limit error is fatal. The client honours the server's
# Retry-After hint between attempts, so a stalled quota window costs wall-clock
# time rather than the whole run.
EMBEDDINGS_MAX_RETRIES=6
EMBEDDINGS_TIMEOUT=120

# text-embedding-3-large is natively 3072-dim and supports Matryoshka
# truncation. Lowering this shrinks storage and speeds up index scans at a small
# recall cost. It must match the vector column width, so changing it on a
# populated table requires a full re-ingest.
EMBEDDINGS_DIMENSIONS=3072

# ── Chunking ──────────────────────────────────────────────────
# Token budget per chunk, measured with the embedding model's own tokenizer.
# Both models accept far more (8191 / 8192), but retrieval quality peaks well
# below the ceiling: a chunk holding one idea ranks better than a page holding
# six, because its vector is not an average of unrelated content.
# 400-512 is the current consensus starting point; tune it by measuring recall
# on your own evaluation set, not by guessing.
MAX_CHUNK_TOKENS=512

# ── Retrieval ─────────────────────────────────────────────────
# Postgres text-search configuration for the BM25 arm. It drives stemming and
# stop words, so it MUST match the language of your documents --
# 'pg_catalog.english' will not stem Spanish, silently degrading keyword recall.
# Use pg_catalog.spanish for a Spanish corpus.
FTS_LANGUAGE=pg_catalog.english

# Documents returned to the caller.
RETRIEVER_K=5

# Candidates pulled from the index before reranking. Keep this generous: the
# reranker can only reorder what recall retrieved, so a relevant chunk missing
# from this pool is lost permanently. Widening it costs one cross-encoder batch.
RETRIEVER_FETCH_K=50

# Cross-encoder that rescores (query, document) pairs by reading both together.
# Runs locally on the GPU in both infrastructure modes, so reranking consumes no
# API quota. bge-reranker-v2-m3 is the companion model to bge-m3 and multilingual.
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_ENABLED=true

# ── Ingestion ─────────────────────────────────────────────────
# Set to 0 to skip Docling and parse PDFs with the faster, lower-fidelity
# PyMuPDF path (no table structure recovery).
RAG_DOCLING=1

# ── Observability (optional) ──────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=onyx
